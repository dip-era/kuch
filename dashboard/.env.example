# Copy to .env.local for local development.

# Recorded sequence (default: the Hugging Face clip)
VITE_FRAME_MANIFEST_URL=https://huggingface.co/datasets/ranbyDipz/sih-lidar-clip/resolve/main/manifest.json

# Uploads through the Hugging Face Space (primary backend)
VITE_HF_SPACE=ranbyDipz/point-matrix-hub

# Backup: the FastAPI backend in backend/ (used only when VITE_HF_SPACE is empty)
# VITE_HF_SPACE=
# VITE_API_BASE_URL=/api
